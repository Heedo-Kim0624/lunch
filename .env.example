# Optional PostgreSQL development configuration.
# The checked-in values below are disposable local defaults, not production secrets.
POSTGRES_DB=lunch
POSTGRES_USER=lunch
POSTGRES_PASSWORD=lunch-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Production uses one Neon pooled connection string instead of the POSTGRES_* values.
# Add it only in Vercel's environment-variable settings; never commit the real value.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG=false. Generate a unique value per environment.
# DJANGO_SECRET_KEY=replace-in-vercel-only
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
